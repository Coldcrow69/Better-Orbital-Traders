<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--create orbital scrapper to buy all items-->
	<TraderKindDef>
		<defName>BetterOrbitalTraders_Scrapper</defName>
		<label>orbital scrapyard</label>
		<orbital>true</orbital>
		<stockGenerators>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Silver</thingDef>
				<countRange>50000~75000</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>Root</categoryDef>
				<thingDefCountRange>0~0</thingDefCountRange>
			</li>
		</stockGenerators>
	</TraderKindDef>
	<!--create orbital ecosphere-->
	<TraderKindDef>
		<defName>BetterOrbitalTraders_Agriculture</defName>
		<label>orbital ecosphere</label>
		<orbital>true</orbital>
		<stockGenerators>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Silver</thingDef>
				<countRange>10000~50000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>WoodLog</thingDef>
				<countRange>1000~5000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Kibble</thingDef>
				<countRange>1000~2000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Hay</thingDef>
				<countRange>5000~10000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Cloth</thingDef>
				<countRange>2500~5000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>MedicineHerbal</thingDef>
				<countRange>500~1000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Chocolate</thingDef>
				<countRange>1000~2000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Dye</thingDef>
				<countRange>500~1000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>InsectJelly</thingDef>
				<countRange>100~500</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Milk</thingDef>
				<countRange>1000~5000</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>PlantFoodRaw</categoryDef>
				<thingDefCountRange>5~99</thingDefCountRange>
				<countRange>1000~10000</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>PlantMatter</categoryDef>
				<thingDefCountRange>5~99</thingDefCountRange>
				<countRange>1000~10000</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>FoodMeals</categoryDef>
				<thingDefCountRange>3~5</thingDefCountRange>
				<countRange>100~500</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>AnimalProductRaw</categoryDef>
				<thingDefCountRange>5~10</thingDefCountRange>
				<countRange>100~500</countRange>
			</li>
			<li Class="StockGenerator_Animals">
				<maxWildness>0.70</maxWildness>
				<checkTemperature>false</checkTemperature>
				<tradeTagsSell>
					<li>AnimalFarm</li>
					<li>AnimalPet</li>
					<li>AnimalExotic</li>
				</tradeTagsSell>
				<tradeTagsBuy>
					<li>AnimalFarm</li>
					<li>AnimalPet</li>
					<li>AnimalExotic</li>
				</tradeTagsBuy>
				<kindCountRange>10~20</kindCountRange>
				<countRange>10~20</countRange>
			</li>
			<li Class="StockGenerator_BuyTradeTag">
				<tag>PlantFoodRaw</tag>
			</li>
			<li Class="StockGenerator_BuyTradeTag">
				<tag>PlantMatter</tag>
			</li>		
		</stockGenerators>
	</TraderKindDef>
	<!--create narcotics dealer-->
	<TraderKindDef>
		<defName>BetterOrbitalTraders_Narcotics</defName>
		<label>narcotics dealer</label>
		<orbital>true</orbital>
		<stockGenerators>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Silver</thingDef>
				<countRange>25000~50000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>MedicineIndustrial</thingDef>
				<countRange>250~500</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>MedicineUltratech</thingDef>
				<countRange>50~100</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Neutroamine</thingDef>
				<countRange>1000~2000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Beer</thingDef>
				<countRange>250~1000</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>Drugs</categoryDef>
				<thingDefCountRange>10~99</thingDefCountRange>
				<countRange>100~500</countRange>
			</li>
			<li Class="StockGenerator_BuyTradeTag">
				<tag>Drugs</tag>
			</li>		
		</stockGenerators>
	</TraderKindDef>
	<!--create autonomous archive-->
	<TraderKindDef>
		<defName>BetterOrbitalTraders_Archive</defName>
		<label>autonomous archive</label>
		<orbital>true</orbital>
		<stockGenerators>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Silver</thingDef>
				<countRange>25000~50000</countRange>
			</li>
			<li Class="StockGenerator_Techprints">
				<countChances>
					<li>
						<count>10</count>
						<chance>1</chance>
					</li>
				</countChances>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>TextBook</thingDef>
				<countRange>5~10</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Schematic</thingDef>
				<countRange>5~10</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Novel</thingDef>
				<countRange>5~10</countRange>
			</li>	
		</stockGenerators>
	</TraderKindDef>
	<!--create organ farm-->
	<TraderKindDef>
		<defName>BetterOrbitalTraders_OrganFarm</defName>
		<label>organ farm</label>
		<orbital>true</orbital>
		<stockGenerators>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Silver</thingDef>
				<countRange>50000~75000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>MedicineIndustrial</thingDef>
				<countRange>250~500</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>MedicineUltratech</thingDef>
				<countRange>50~100</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Neutroamine</thingDef>
				<countRange>1000~2000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef" MayRequire="Ludeon.Rimworld.Biotech">
				<thingDef>HemogenPack</thingDef>
				<countRange>100~500</countRange>
			</li>
			<li Class="StockGenerator_SingleDef" MayRequire="Ludeon.Rimworld.Biotech">
				<thingDef>Genepack</thingDef>
				<countRange>5~10</countRange>
			</li>
			<li Class="StockGenerator_SingleDef" MayRequire="Ludeon.Rimworld.Biotech">
				<thingDef>ArchiteCapsule</thingDef>
				<countRange>2~2</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Meat_Human</thingDef>
				<countRange>100~1000</countRange>
			</li>
			<li Class="StockGenerator_SingleDef">
				<thingDef>Leather_Human</thingDef>
				<countRange>100~1000</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>BodyPartsNatural</categoryDef>
				<thingDefCountRange>5~10</thingDefCountRange>
				<countRange>10~25</countRange>
			</li>
			<li Class="StockGenerator_Category">
				<categoryDef>BodyParts</categoryDef>
				<thingDefCountRange>10~25</thingDefCountRange>
				<countRange>1~2</countRange>
			</li>
			<li Class="StockGenerator_Slaves">
				<countRange>1~5</countRange>
			</li>
			<li Class="StockGenerator_BuyTradeTag">
				<tag>BodyParts</tag>
			</li>
		</stockGenerators>
	</TraderKindDef>
</Defs>