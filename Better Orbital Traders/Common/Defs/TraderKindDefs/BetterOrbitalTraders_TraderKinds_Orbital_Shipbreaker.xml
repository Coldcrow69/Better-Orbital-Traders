<?xml version="1.0" encoding="utf-8"?>
<!--
  Better Orbital Traders: orbital shipbreaker. Odyssey only.

  Everything that makes this ship worth visiting (gravlite panels, vacstone, obsidian, shuttle
  engines) is an Odyssey item, so the whole def carries MayRequire and simply does not exist
  without the DLC. Vanilla gates a handful of its own defs the same way. The Odyssey patch adds it
  to the Traders Guild request list, and the faction tag needs no MayRequire of its own here.
-->
<Defs>

  <!-- Orbital shipbreaker. Hull plating, drive parts, and the metal it all came from. -->
  <TraderKindDef MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>BetterOrbitalTraders_Shipbreaker</defName>
    <label>orbital shipbreaker</label>
    <orbital>true</orbital>
    <faction>TradersGuild</faction>
    <stockGenerators>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>25000~50000</countRange>
      </li>
      <!-- Gravship parts. Vanilla ships carry a coin-flip handful of panels and 0 to 1 engine. -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>GravlitePanel</thingDef>
        <countRange>200~800</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ShuttleEngine</thingDef>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>BlocksVacstone</thingDef>
        <countRange>500~2000</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Obsidian</thingDef>
        <countRange>200~1000</countRange>
      </li>
      <!-- Salvaged bulk. -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentIndustrial</thingDef>
        <countRange>50~200</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>ComponentSpacer</thingDef>
        <countRange>5~20</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>2000~8000</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Plasteel</thingDef>
        <countRange>500~2000</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Uranium</thingDef>
        <countRange>200~800</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Chemfuel</thingDef>
        <countRange>500~2000</countRange>
      </li>
      <!-- Buys anything tagged as a gravship upgrade, same as the vanilla orbital traders. -->
      <li Class="StockGenerator_BuyTradeTag">
        <tag>GravshipUpgrade</tag>
      </li>
    </stockGenerators>
  </TraderKindDef>

</Defs>
